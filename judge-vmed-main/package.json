{
  "name": "judge-vmed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "bun run build && vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "db:migrate:local": "wrangler d1 migrations apply judge-vmed --local",
    "db:migrate:remote": "wrangler d1 migrations apply judge-vmed --remote",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "@clerk/react": "^6.15.2",
    "hono": "^4.13.7",
    "lucide-react": "1.45.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/node": "^24",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "typescript": "~5.8.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
